{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug QuickTui Demo",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-quicktui",
            "program": "${workspaceFolder}/src/QuickTui.Demo/bin/Debug/net10.0/QuickTui.Demo.dll",
            "cwd": "${workspaceFolder}/src/QuickTui.Demo",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Debug QuickTui Demo (External Terminal)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-quicktui",
            "program": "${workspaceFolder}/src/QuickTui.Demo/bin/Debug/net10.0/QuickTui.Demo.dll",
            "cwd": "${workspaceFolder}/src/QuickTui.Demo",
            "console": "externalTerminal",
            "stopAtEntry": false
        }
    ]
}
